{
  "name": "ng-mcp-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Angular schematic + library that retrofits Angular apps with MCP interactive UI views",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs"
  ],
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "node tools/typecheck.mjs",
    "build": "npm run build --workspace ng-mcp-ui --workspace ng-mcp-ui-schematics --if-present",
    "docs:dev": "npm run dev --workspace ng-mcp-ui-docs",
    "docs:build": "npm run build --workspace ng-mcp-ui-docs",
    "docs:preview": "npm run preview --workspace ng-mcp-ui-docs",
    "pretest": "npm run build --workspace ng-mcp-ui-schematics",
    "test": "vitest run --passWithNoTests",
    "test:types": "vitest run --typecheck.only",
    "ci:fixture": "node tools/ci-fixture.mjs",
    "live-host": "node tools/ci-fixture.mjs --serve --tunnel",
    "check:version": "node tools/check-version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "^25.9.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  }
}
